# ---------------------------------------------------------------------------
# Local development defaults (match docker-compose.yml)
# Run `pnpm setup` to create .env, start Postgres and seed demo data.
# ---------------------------------------------------------------------------
PAYLOAD_SECRET=mygeneratedsecret
DATABASE_URL=postgresql://payload:payload@localhost:5432/formula_k
# Local Postgres from docker-compose.yml does not use TLS.
# Leave this unset (or true) for managed Postgres in production.
DB_SSL=false

COMPANY_NAME="Formula K"
TWITTER_CREATOR="@payloadcms"
TWITTER_SITE="https://nextjs.org/commerce"
SITE_NAME="Formula K"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Stripe API keys (online payments are disabled — Cash on Delivery only)
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# Cloudflare R2 Storage (S3-compatible) — optional, local disk is used when unset.
# Leave these commented out for local development. Placeholder values are detected
# and ignored, but real-looking-but-wrong credentials will silently break media.
# R2_BUCKET=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Public hostname media is served from (needed so next/image can optimise R2 files)
# R2_PUBLIC_URL=

# Email (SMTP) — optional in development, required for order confirmation emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=cs@formula-k.tn
SMTP_FROM_NAME="Formula K"

# ---------------------------------------------------------------------------
# AI admin assistant (/admin/ai) — see docs/admin-ai-assistant.md
# Without DEEPSEEK_API_KEY the assistant returns a clear configuration error;
# nothing else in the app depends on it.
# ---------------------------------------------------------------------------
AI_PROVIDER=deepseek
# Unversioned alias currently serving DeepSeek V4.1 Flash.
# Versioned alternatives: deepseek-v4-flash, deepseek-v4-pro
AI_MODEL=deepseek-flash
# DeepSeek V4 turns thinking ON by default, which silently disables
# temperature/topP and bills reasoning tokens on every turn of the tool loop.
# Set to "enabled" to opt back in.
AI_THINKING=disabled
DEEPSEEK_API_KEY=

# Official Payload MCP server at POST /api/mcp, for external clients such as
# Claude Desktop. Read-only by default. Requires the access-control refactor
# described in docs/admin-ai-assistant.md before it can be enabled.
# MCP_ENABLED=false
